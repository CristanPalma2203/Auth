# Copiar a Auth/.env o a src/WebApi/appsettings.Local.json (gitignored).
AppSettings__Secret=
ConnectionStrings__DefaultConnection=
AppSettings__ConnectionStringsRedis=
Email__Resend__ApiKey=
OAuth__Google__ClientId=
OAuth__Google__ClientSecret=
OAuth__Google__CallbackUrl=http://localhost:8081/api/OAuth/google/callback
OAuth__Google__DefaultReturnUrl=http://localhost:5173/auth/callback
AppSettings__DireccionPortal=http://localhost:3000/#/login
AppSettings__VerifyEmail=http://localhost:3000/#/verificar-correo
AppSettings__VerifyEmailStorefront=http://localhost:5173/verificar-correo
# CORS (ACA STG ca-corelux-auth-stg). Indexed env overrides the same JSON index.
# Do not set these on production ACA. Apex is required — QA uses temporasv.com (no www).
# Cors__AllowedOrigins__0=https://temporasv.com
# Cors__AllowedOrigins__1=https://www.temporasv.com
# Alternative single setting (comma-separated), same section:
# Cors__AllowedOrigins=https://temporasv.com,https://www.temporasv.com
# Error por defecto en staging; cambiar temporalmente a Warning, Information o Debug.
Serilog__MinimumLevel__Default=Error
Serilog__MinimumLevel__Override__Microsoft=Error
Serilog__MinimumLevel__Override__System=Error
